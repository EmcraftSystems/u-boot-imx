/dts-v1/;
#include "imxrt1050.dtsi"
#include "imxrt1050-pinfunc.h"

/ {
	model = "NXP IMXRT1050-evk board";
	compatible = "fsl,imxrt1050-evk", "fsl,imxrt1050";

	chosen {
		stdout-path = &lpuart1;
	};

	aliases {
		gpio0 = &gpio1;
		gpio1 = &gpio2;
		gpio2 = &gpio3;
		gpio3 = &gpio4;
		gpio4 = &gpio5;
		mmc0 = &usdhc1;
		serial0 = &lpuart1;
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x80000000 0x2000000>;
	};
};

&lpuart1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_lpuart1>;
	status = "okay";
};

&iomuxc {
	pinctrl-names = "default";
	pinctrl_lpuart1: lpuart1grp {
		fsl,pins = <
			MXRT1050_IOMUXC_GPIO_AD_B0_12_LPUART1_TXD	0xf1
			MXRT1050_IOMUXC_GPIO_AD_B0_13_LPUART1_RXD	0xf1
		>;
	};

	pinctrl_usdhc0: usdhc0grp {
		fsl,pins = <
			MXRT1050_IOMUXC_GPIO_B1_12_USDHC1_CD_B		0x1B000
			MXRT1050_IOMUXC_GPIO_B1_14_USDHC1_VSELECT	0xB069
			MXRT1050_IOMUXC_GPIO_SD_B0_00_USDHC1_CMD	0x17061
			MXRT1050_IOMUXC_GPIO_SD_B0_01_USDHC1_CLK	0x17061
			MXRT1050_IOMUXC_GPIO_SD_B0_05_USDHC1_DATA3	0x17061
			MXRT1050_IOMUXC_GPIO_SD_B0_04_USDHC1_DATA2	0x17061
			MXRT1050_IOMUXC_GPIO_SD_B0_03_USDHC1_DATA1	0x17061
			MXRT1050_IOMUXC_GPIO_SD_B0_02_USDHC1_DATA0	0x17061
		>;
	};

	pinctrl_fec: fecgrp {
		fsl,pins = <
			MXRT1050_IOMUXC_GPIO_B1_04_ENET_RX_DATA00	(IMX_PAD_SION | 0xB0E9)
			MXRT1050_IOMUXC_GPIO_B1_05_ENET_RX_DATA01	(IMX_PAD_SION | 0xB0E9)
			MXRT1050_IOMUXC_GPIO_B1_06_ENET_RX_EN		0xB0E9
			MXRT1050_IOMUXC_GPIO_B1_07_ENET_TX_DATA00	0xB0E9
			MXRT1050_IOMUXC_GPIO_B1_08_ENET_TX_DATA01	0xB0E9
			MXRT1050_IOMUXC_GPIO_B1_09_ENET_TX_EN		0xB0E9
			MXRT1050_IOMUXC_GPIO_B1_10_ENET_REF_CLK		(IMX_PAD_SION | 0xB0E9)
			MXRT1050_IOMUXC_GPIO_B1_11_ENET_RX_ER		0xB0E9
			MXRT1050_IOMUXC_GPIO_EMC_40_ENET_MDC		0xB0E9
			MXRT1050_IOMUXC_GPIO_EMC_41_ENET_MDIO		0xB0E9
			/* RST */
			MXRT1050_IOMUXC_GPIO_AD_B0_09_GPIO1_IO09	0xB0A9
			/* INT */
			MXRT1050_IOMUXC_GPIO_AD_B0_10_GPIO1_IO10	0xB0E9
		>;
	};
};

&usdhc1 {
	pinctrl-names = "default", "state_100mhz", "state_200mhz", "sleep";
	pinctrl-0 = <&pinctrl_usdhc0>;
	pinctrl-1 = <&pinctrl_usdhc0>;
	pinctrl-2 = <&pinctrl_usdhc0>;
	pinctrl-3 = <&pinctrl_usdhc0>;
	cd-gpios = <&gpio2 28 GPIO_ACTIVE_LOW>;
	status = "okay";
};

&usbotg1 {
	dr_mode = "host";
	status = "okay";
};

&fec {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_fec>;

	status = "okay";
	phy-mode = "rmii";

	phy-handle = <&ethphy0>;
	phy-reset-duration = <1>;
	phy-reset-gpios = <&gpio1 9 GPIO_ACTIVE_LOW>;

	clocks = <&clks IMXRT1050_CLK_ENET>, <&clks IMXRT1050_CLK_ENET_REF>;
	clock-names = "ipg", "enet_clk_ref";

	assigned-clocks = <&clks IMXRT1050_CLK_PLL6_BYPASS>;
	assigned-clock-parents = <&clks IMXRT1050_CLK_PLL6_ENET>;

	mdio {
		#address-cells = <1>;
		#size-cells = <0>;

		ethphy0: ethernet-phy@2 {
			reg = <2>;
			micrel,led-mode = <1>;
		};
	};
};
