/* environment for imxrt1050-evk */

#include <env/nxp/imxrt_env.env>

#if 0
#ifdef CONFIG_VIDEO
stdin=serial
stdout=serial,vidconsole
stderr=serial,vidconsole
#endif

fdt_addr_r=0x80800000
kernel_addr_r=0x80000000
boot_targets=mmc
#endif

#if CONFIG_IS_ENABLED(SPLASH_SCREEN) && CONFIG_IS_ENABLED(MMC)
splashsource=mmc_fs
#endif

#if CONFIG_IS_ENABLED(CMD_TFTPBOOT)
serverip=172.17.0.1
gatewayip=172.17.0.1
#if CONFIG_IS_ENABLED(TARGET_IMXRT1050_EVK)
ethaddr=aa:bb:cc:dd:ee:d0
tftpdir=imxrt1050
ipaddr=172.17.44.105
#elif CONFIG_IS_ENABLED(TARGET_IMXRT1060_EVK)
ethaddr=aa:bb:cc:dd:ee:e0
tftpdir=imxrt1060
ipaddr=172.17.44.106
#endif
#endif
