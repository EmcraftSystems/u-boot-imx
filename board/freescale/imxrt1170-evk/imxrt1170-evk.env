/* environment for imxrt1170-evk */

#include <env/nxp/imxrt_env.env>

#if CONFIG_IS_ENABLED(CMD_TFTPBOOT)
serverip=172.17.0.1
ipaddr=172.17.44.111
netmask=255.255.0.0
gatewayip=172.17.0.1
tftpdir=imxrt1170/
#endif


#if CONFIG_IS_ENABLED(CMD_SF)
uboot_sf_offset=0x0
uboot_sf_size=0x60000
kernel_sf_offset=0x80000
kernel_sf_size=0x800000
rootfs_sf_offset=0x880000
rootfs_sf_size=0x780000
#endif

#if defined(CONFIG_SPL_DFU)
dfu_alt_info_ram=u-boot ram 0x80001fc0 0x80000
dfu_alt_info=spl raw 0x0 0x10000;u-boot raw 0x10000 0x50000;kernel raw 0x80000 0xf80000;rootfs raw 0x880000 0x780000
#endif
