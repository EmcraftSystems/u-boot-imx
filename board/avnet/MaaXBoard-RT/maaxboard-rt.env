/* environment for MaaXBoard-RT */

#include <env/nxp/imxrt_env.env>

#if CONFIG_IS_ENABLED(CMD_TFTPBOOT)
ethaddr=aa:bb:cc:dd:ee:f8
serverip=172.17.0.1
ipaddr=172.17.44.141
netmask=255.255.0.0
gatewayip=172.17.0.1
tftpdir=imxrt1170/
#endif

/* HyperFlash partition addresses (flash base 0x30000000) */
kernel_flash_addr=30100000
kernel_flash_size=d00000
rootfs_flash_addr=30e00000
rootfs_flash_size=1200000
